# ==========================================
# Cookly Environment Configuration Example
# ==========================================

# Server Port (Render / Railway / Cloud providers usually inject this automatically)
PORT=5000

# Environment Mode: development | production | test
NODE_ENV=production

# Frontend Client Origin (Used for CORS in production if hosted on separate domains)
# Example for Vercel + Render: CLIENT_ORIGIN=https://cookly.vercel.app
# If hosted as a single full-stack service on Render, you can omit or set to your Render URL:
CLIENT_ORIGIN=https://cookly-app.onrender.com

# Database File Path
# For Render Persistent Disk mounted at /data:
# DATABASE_PATH=/data/cookly.db
# For local development (defaults to ./data/cookly.db):
DATABASE_PATH=data/cookly.db

# JWT Secret for User Authentication (Use a long, random secure string in production)
JWT_SECRET=replace_with_a_secure_random_32_character_string

# Recipe Provider API Key (Optional)
# Spoonacular API key for extended real recipe search (TheMealDB & DummyJSON run without keys as defaults)
SPOONACULAR_API_KEY=

# Cache & Rate Limiting Settings (Optional, defaults provided)
CACHE_TTL_SECONDS=300
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
